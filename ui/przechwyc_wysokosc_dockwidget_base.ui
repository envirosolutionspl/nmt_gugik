  <property name="styleSheet">
   <string notr="true">* { font-family: "DejaVu Sans"; }
QScrollArea#scrollArea { border: none; background: transparent; }
QLabel#lbl_title { font-size: 16px; font-weight: 700; }
QLabel#lbl_subtitle, QLabel#lbl_pluginVersion { font-size: 11px; }
QToolButton#btn_help, QToolButton#btn_close { border: none; border-radius: 6px; padding: 3px; }
QLabel#lbl_email, QLabel#lbl_szkolenia { font-size: 10px; }
QLabel#label_5 { background: transparent; padding: 0px; }

QFrame#card_capture, QFrame#card_result { border-radius: 6px; }
QLabel[role="card-title"] { font-size: 13px; font-weight: 700; padding: 2px 10px; border-top-left-radius: 5px; border-top-right-radius: 5px; }
QLabel[role="hint"] { font-size: 10px; }
QLabel[role="caption"] { font-size: 10px; }
QLabel[role="unit"] { font-weight: 700; }

QLineEdit { border-radius: 4px; padding: 0px 6px; }
QLineEdit#heightEdit { font-size: 18px; font-weight: 700; padding: 0px 8px; }
QLineEdit#coordsEdit { font-family: Consolas; font-size: 12px; }

QPushButton { border-radius: 4px; padding: 4px 12px; min-height: 16px; }
QPushButton[role="primary"] { font-weight: 700; padding: 4px 10px; border: none; }
QPushButton#captureButton { font-size: 13px; }

QPushButton:focus, QToolButton:focus { outline: none; }

QDockWidget[theme="light"] QWidget#dockWidgetContents, QDockWidget[theme="light"] QWidget#content_widget { background: #ffffff; }
QDockWidget[theme="light"] QLabel { color: #23282a; }
